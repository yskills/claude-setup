  "rules": [
    "common",
    "typescript",
    "vue",
    "nuxt",
    "web",
    "python"
  ],
  "hooks": {
    "profile": "standard",
    "disabled": [
      "pre:bash:auto-tmux-dev",
      "pre:bash:tmux-reminder",
      "pre:bash:gateguard-fact-force",
      "pre:edit-write:gateguard-fact-force"
    ]
  },
  "ruleExcludes": [
    "common/agents.md"
  ],
  "$comment_ruleExcludes": "common/agents.md names agents as ecc:<name>, which only exists with the full plugin; our CLAUDE.md lists the agents instead."
