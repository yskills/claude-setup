{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "$comment": "These deny rules apply only in a one-repository session. A project thread with claude-setup plus the app repo ignores them (per the Projects docs); that is fine because the thread's own rules come from the cloud environment.",
  "permissions": {
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.production)",
      "Read(**/.env.*.local)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Edit(**/.env)",
      "Edit(**/.env.local)",
      "Edit(**/.env.production)",
      "Read(**/.dev.vars)",
      "Read(**/.env.development)",
      "Read(**/.env.staging)",
      "Read(~/.npmrc)",
      "Read(~/.config/gh/**)",
      "Read(~/.config/.wrangler/**)",
      "Read(~/.wrangler/**)",
      "Edit(**/.dev.vars)",
      "Edit(**/.env.development)",
      "Edit(**/.env.staging)"
    ]
  }
}
